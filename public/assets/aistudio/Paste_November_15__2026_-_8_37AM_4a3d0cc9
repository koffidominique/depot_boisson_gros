### 4.4 NestJS : Guard + Décorateur + Service

#### 4.4.1 Le décorateur `@RequirePermissions`

```typescript
// src/auth/require-permissions.decorator.ts
import { SetMetadata } from '@nestjs/common';

export const PERMISSIONS_KEY = 'permissions';
export const RequirePermissions = (...permissions: string[]) =>
  SetMetadata(PERMISSIONS_KEY, permissions);
```

#### 4.4.2 Le guard principal

```typescript
// src/auth/permissions.guard.ts
import {
  CanActivate, ExecutionContext, Injectable, ForbiddenException,
} from '@nestjs/common';
import { Reflector } from '@nestjs/core';
import { PERMISSIONS_KEY } from './require-permissions.decorator';
import { RolePermissionsService } from './role-permissions.service';
import { DelegationService } from './delegation.service';

@Injectable()
export class PermissionsGuard implements CanActivate {
  constructor(
    private reflector: Reflector,
    private rolePermissions: RolePermissionsService,
    private delegations: DelegationService,
  ) {}

  async canActivate(ctx: ExecutionContext): Promise<boolean> {
    const required = this.reflector.getAllAndOverride<string[]>(
      PERMISSIONS_KEY, [ctx.getHandler(), ctx.getClass()],
    );
    if (!required || required.length === 0) return true;

    const req = ctx.switchToHttp().getRequest();
    const user = req.user; // injecté par JwtAuthGuard en amont
    if (!user) throw new ForbiddenException('Non authentifié');

    // 1. Permissions natives du rôle
    const base = await this.rolePermissions.getForRole(user.role);

    // 2. Permissions déléguées temporairement
    const delegated = await this.delegations.getActiveForUser(user.id);

    const granted = new Set([...base, ...delegated]);
    const missing = required.filter((p) => !granted.has(p));
    if (missing.length > 0) {
      throw new ForbiddenException(
        `Permissions manquantes : ${missing.join(', ')}`,
      );
    }

    // 3. Enrichir la requête pour les guards suivants (scope)
    req.userPermissions = granted;
    return true;
  }
}
```

#### 4.4.3 Le guard de périmètre (isolation multi-dépôts)

```typescript
// src/auth/warehouse-scope.guard.ts
import {
  CanActivate, ExecutionContext, ForbiddenException, Injectable,
} from '@nestjs/common';

@Injectable()
export class WarehouseScopeGuard implements CanActivate {
  canActivate(ctx: ExecutionContext): boolean {
    const req = ctx.switchToHttp().getRequest();
    const user = req.user;

    // Propriétaire : accès à tous les dépôts, pas de filtrage
    if (user.role === 'proprietaire') return true;

    // Gérant / Livreur : un seul dépôt imposé
    const requestedWarehouse =
      req.params.warehouseId ??
      req.query.warehouseId ??
      req.body.warehouseId;

    if (requestedWarehouse && requestedWarehouse !== user.warehouseId) {
      throw new ForbiddenException(
        'Accès refusé à un autre dépôt que le vôtre.',
      );
    }

    // On force le filtre sur toutes les requêtes de données
    req.scopeWarehouseId = user.warehouseId;
    return true;
  }
}
```

#### 4.4.4 Le guard livreur (isolation tournée)

```typescript
// src/delivery/own-route.guard.ts
@Injectable()
export class OwnRouteGuard implements CanActivate {
  constructor(private deliveryService: DeliveryService) {}

  async canActivate(ctx: ExecutionContext): Promise<boolean> {
    const req = ctx.switchToHttp().getRequest();
    const user = req.user;
    if (user.role !== 'livreur') return true;

    const routeId = req.params.routeId;
    const route = await this.deliveryService.findById(routeId);
    if (!route || route.livreurId !== user.id) {
      throw new ForbiddenException('Cette tournée ne vous appartient pas.');
    }
    return true;
  }
}
```

#### 4.4.5 Application sur un controller

```typescript
// src/sales/sales.controller.ts
@Controller('sales')
@UseGuards(JwtAuthGuard, PermissionsGuard, WarehouseScopeGuard)
export class SalesController {
  @Post()
  @RequirePermissions(P.SALE_CREATE)
  create(@Body() dto: CreateSaleDto, @CurrentUser() user: User) {
    return this.salesService.create(dto, user);
  }

  @Post(':id/validate')
  @RequirePermissions(P.SALE_VALIDATE)
  validate(@Param('id') id: string, @CurrentUser() user: User) {
    return this.salesService.validate(id, user);
  }

  @Post(':id/discount')
  @RequirePermissions(P.SALE_DISCOUNT_5) // gérant peut jusqu'à 5%
  applyDiscount(
    @Param('id') id: string,
    @Body() dto: { percent: number; reason: string },
    @CurrentUser() user: User,
  ) {
    // check fin dans le service : si percent > 5, valide via workflow
    return this.salesService.applyDiscount(id, dto, user);
  }
}
```

#### 4.4.6 Les règles de gouvernance dans le service (pas juste en guard)

Le guard contrôle **« a-t-il le droit de faire l'action ? »**. Le service contrôle **« cette action précise est-elle permise à cet instant ? »**.

```typescript
// src/sales/sales.service.ts
@Injectable()
export class SalesService {
  async validate(saleId: string, user: User) {
    const sale = await this.repo.findById(saleId);

    // Règle 1 : ne pas valider sa propre vente > seuil (gérant)
    // (toléré en dessous du seuil car gérant solo sur le terrain)
    const total = sale.total;
    const SEUIL_AUTO_VALIDATION = 200_000; // FCFA
    if (
      sale.createdBy === user.id &&
      total > SEUIL_AUTO_VALIDATION &&
      user.role !== 'proprietaire'
    ) {
      throw new ForbiddenException(
        `Vente > ${SEUIL_AUTO_VALIDATION} FCFA : validation par le propriétaire requise.`,
      );
    }

    // Règle 2 : une vente dans une caisse déjà clôturée ne peut être annulée que par le propriétaire
    if (sale.cashSessionId && sale.status === 'closed') {
      this.assertPermission(user, 'sale.cancel_closed');
    }

    // Règle 3 : décrémenter stock + consignes + audit
    await this.applyStockAndConsignments(sale, user);
    await this.audit.log({
      action: 'VALIDATE',
      entity: 'sale',
      entityId: sale.id,
      userId: user.id,
      after: { status: 'validated' },
    });
    return this.repo.updateStatus(saleId, 'validated');
  }

  async applyDiscount(saleId: string, dto: DiscountDto, user: User) {
    const sale = await this.repo.findById(saleId);

    if (dto.percent > 5) {
      // Au-delà de 5% : on ne l'applique pas, on CRÉE UNE DEMANDE DE VALIDATION
      await this.approvals.create({
        type: 'SALE_DISCOUNT_OVER_5',
        entityId: saleId,
        requestedBy: user.id,
        payload: { percent: dto.percent, reason: dto.reason },
        targetRole: 'proprietaire',
      });
      return { status: 'pending_approval' };
    }
    return this.repo.applyDiscount(saleId, dto.percent, dto.reason, user.id);
  }

  private assertPermission(user: User, code: string) {
    if (!user.permissions.includes(code)) {
      throw new ForbiddenException(`Permission requise : ${code}`);
    }
  }
}
```

### 4.5 Le workflow d'approbation (propriétaire à distance)

Pour les actions que le gérant **initie mais ne peut pas valider lui-même**, on utilise une table `approvals` :

```sql
CREATE TABLE approvals (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    company_id      UUID NOT NULL REFERENCES companies(id),
    type            VARCHAR(50) NOT NULL,   -- SALE_DISCOUNT_OVER_5, STOCK_ADJUST_OVER_5, CREDIT_WRITE_OFF, CONSIGNMENT_LOSS_OVER, CASH_CLOSE_VALIDATE
    entity          VARCHAR(50) NOT NULL,
    entity_id       UUID NOT NULL,
    payload         JSONB NOT NULL,
    requested_by    UUID NOT NULL REFERENCES users(id),
    requested_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
    target_role     user_role NOT NULL,     -- qui peut valider (proprietaire)
    status          VARCHAR(20) NOT NULL DEFAULT 'pending', -- pending, approved, rejected, expired
    decided_by      UUID REFERENCES users(id),
    decided_at      TIMESTAMPTZ,
    decision_note   TEXT
);
```

**Sur le terrain** : le gérant fait sa demande via l'app, le propriétaire reçoit une **notification in-app + SMS/WhatsApp**, valide depuis son téléphone en 2 clics. Sans cela, les dépôts « bloquent » quand le propriétaire n'est pas là — c'est la première cause d'abandon d'un ERP dans ce contexte.

```typescript
// src/approvals/approvals.service.ts
async approve(approvalId: string, user: User, note?: string) {
  const approval = await this.repo.findById(approvalId);

  if (approval.status !== 'pending') {
    throw new BadRequestException('Demande déjà traitée.');
  }
  if (user.role !== approval.targetRole) {
    throw new ForbiddenException(
      `Seul un ${approval.targetRole} peut valider cette demande.`,
    );
  }
  if (approval.requestedBy === user.id) {
    throw new ForbiddenException('Auto-validation interdite.');
  }

  // Exécuter l'action métier selon le type
  await this.executeApprovedAction(approval);

  await this.repo.update(approvalId, {
    status: 'approved',
    decidedBy: user.id,
    decidedAt: new Date(),
    decisionNote: note,
  });

  await this.audit.log({
    action: 'APPROVE',
    entity: 'approval',
    entityId: approval.id,
    userId: user.id,
    after: { status: 'approved', note },
  });

  await this.notifications.notify(approval.requestedBy, {
    title: 'Demande approuvée',
    body: `${approval.type} validée par ${user.fullName}.`,
  });
}
```

